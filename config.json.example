{
  "llm_api_key": "sk-your-deepseek-key",
  "llm_base_url": "https://api.deepseek.com/v1",
  "llm_model": "deepseek-chat",
  "llm_fast_model": "deepseek-chat",
  "llm_temperature": 0.1,
  "llm_max_tokens": 8192,
  "admin_llm_max_tokens": 3072,
  "admin_llm_timeout_seconds": 60,
  "llm_timeout_seconds": 120,
  "llm_send_disable_thinking": false,
  "llm_io_log_dir": "logs/llm_io",
  "articles_dir": "data/articles",
  "output_csv": "data/output/all_positions.csv",
  "output_json": "data/output/all_positions.json",
  "skip_log": "logs/non_recruitment.log",
  "prefilter_enabled": true,
  "prefilter_min_hits": 1,
  "relevance_lexicon": "job_structuring/data/relevance_lexicon.json",
  "relevance_titles_csv": "",
  "relevance_titles_xlsx": "生涯智能体信息源.xlsx",
  "backend_base_url": "http://localhost:9100",
  "job_post_batch_path": "/internal/job-post/batch",
  "job_post_list_path": "/internal/job-post/list",
  "upload_batch_size": 50,
  "upload_fetch_existing": true,
  "upload_fetch_page_size": 200,
  "upload_timeout_seconds": 120,
  "upload_state_file": "logs/uploaded_job_keys.json",
  "upload_log_file": "logs/upload_backend.log"
}
